# scratch / local
.claude/
__pycache__/
*.pyc
.DS_Store
*.log
.venv/

# scraped video cache for scripts/scrape_bilibili_cn.py
.bilicache/

# local Qimai fetch tooling + cookies — stays on the owner's PC only, never in the repo.
# (Qimai binds sessions to the login IP, so the fetch has to run locally; only the resulting
#  data/qimai.json + data/qimai_daily are committed. build_qimai.py — a pure, cookie-free
#  rebuild of that data — stays tracked for provenance.)
scripts/.qimai_cookie*
scripts/.qimai_accounts.json
scripts/qimai_gui.py
scripts/fetch_qimai_today.py
scripts/fetch_qimai_ranks.py
scripts/qimai_daily.ps1
qimai_daily.bat

# one-click daily fetch (auto_daily.py): per-account persistent browser profiles,
# optional credentials.json, per-day quota state, diandian sniff dumps — local only.
# Diandian fallback numbers are a different model/currency: kept as a separate,
# local-only series until the owner decides to publish them.
scripts/auto_daily.py
scripts/diandian_fetch.py
qimai_auto.bat
scripts/.auto/
data/diandian_daily/

# CN scrape working files (the merged data/cn_revenue.json + cn_monthly.json are committed)
data/cn_shards/
data/cn_verify/

# scripts/compute_focus.py: its detector venv (pip install -r requirements-focus.txt) and
# downloaded-art cache. .face_cv2 is a retired local OpenCV 4.x install from the old
# cascade detector — still ignored so it can never be committed by accident.
.focusenv/
scripts/.face_cv2/
scripts/.focus_imgcache/
